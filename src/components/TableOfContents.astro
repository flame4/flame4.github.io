---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(
  heading => heading.depth >= 2 && heading.depth <= 3
);
---

{
  tocHeadings.length > 0 && (
    <nav
      aria-labelledby="table-of-contents-title"
      class="border-border bg-muted/20 my-6 rounded border p-4"
    >
      <p
        id="table-of-contents-title"
        class="text-foreground mb-2 font-semibold"
      >
        目录
      </p>
      <ul class="m-0 list-none space-y-1 p-0 text-sm">
        {tocHeadings.map(heading => (
          <li class:list={["m-0", { "ms-4": heading.depth === 3 }]}>
            <a
              href={`#${heading.slug}`}
              class="text-foreground/80 hover:text-accent wrap-break-word no-underline"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
