---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(
  heading => heading.depth >= 2 && heading.depth <= 3
);
---

{
  tocHeadings.length > 0 && (
    <aside data-table-of-contents="true" class="self-start lg:sticky lg:top-8">
      <nav
        aria-labelledby="table-of-contents-title"
        class="border-border bg-muted/20 rounded border p-4 lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto"
      >
        <p
          id="table-of-contents-title"
          class="text-foreground mb-2 font-semibold"
        >
          目录
        </p>
        <ul class="m-0 list-none space-y-1 p-0 text-sm">
          {tocHeadings.map(heading => (
            <li class:list={["m-0", { "ms-4": heading.depth === 3 }]}>
              <a
                href={`#${heading.slug}`}
                class="text-foreground/80 hover:text-accent wrap-break-word no-underline"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}
